ARG BASE_IMAGE_HASH

FROM node:22.23.4-bookworm-slim AS key

WORKDIR /key

COPY packages/utils/lib/license/key.ts scripts/write-license-key.mjs ./

ARG NANGO_LICENSE_PUBLIC_KEY
RUN true \
  && node write-license-key.mjs key.ts \
  && npx --yes -p typescript@5.8.3 tsc --module es2022 --target es2022 --strict --outDir dist key.ts

FROM nangohq/nango:${BASE_IMAGE_HASH}

COPY --from=key /key/dist/key.js packages/utils/dist/license/key.js

ENV NANGO_ENTERPRISE=true
