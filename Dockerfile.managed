ARG BASE_IMAGE_HASH

# key.js is plain JS, so compile it once on the build platform rather than per target
FROM --platform=$BUILDPLATFORM node:22.23.4-bookworm-slim AS key

WORKDIR /key

COPY packages/license/lib/key.ts scripts/write-license-key.mjs ./

ARG NANGO_LICENSE_PUBLIC_KEY
RUN true \
  && node write-license-key.mjs key.ts \
  && npx --yes -p typescript@5.8.3 tsc --module es2022 --target es2022 --outDir dist key.ts

FROM nangohq/nango:${BASE_IMAGE_HASH}

COPY --from=key /key/dist/key.js packages/license/dist/key.js

ENV NANGO_ENTERPRISE=true
