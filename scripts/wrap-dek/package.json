{
    "name": "wrap-dek",
    "version": "1.0.0",
    "description": "Wrap/unwrap the Nango global DEK with an AWS KMS, GCP Cloud KMS or Azure Key Vault master key (AWS Encryption SDK envelope)",
    "type": "module",
    "private": true,
    "scripts": {
        "sync-gcp": "cp ../../packages/kms/lib/gcp.ts ./gcp.ts",
        "sync-azure": "cp ../../packages/kms/lib/azure.ts ./azure.ts"
    },
    "dependencies": {
        "@aws-crypto/client-node": "^5.0.0",
        "@azure/identity": "4.13.2",
        "@azure/keyvault-keys": "4.10.2",
        "@google-cloud/kms": "5.7.0",
        "google-auth-library": "10.5.0"
    },
    "devDependencies": {
        "tsx": "^4.22.4"
    }
}
