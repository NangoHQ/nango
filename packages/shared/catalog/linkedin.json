        {
            "type": "action",
            "description": "Create a comment on a LinkedIn post or comment thread.",
            "endpoint": null,
            "input": "ActionInput_linkedin_createcomment",
            "name": "create-comment",
            "output": ["ActionOutput_linkedin_createcomment"],
            "scopes": ["w_organization_social_feed", "w_member_social_feed"],
