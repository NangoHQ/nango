            "version": "1.0.1",
            "json_schema": {
                "definitions": {
                    "ActionInput_linkedin_createcomment": {
                        "type": "object",
                        "properties": {
                            "target": {
                                "type": "string",
                                "description": "The URN of the share, ugcPost, or comment to comment on. Example: \"urn:li:ugcPost:123\""
                            },
                            "actor": {
                                "type": "string",
                                "description": "The URN of the entity authoring the comment. Example: \"urn:li:person:abc\" or \"urn:li:organization:123\""
                            },
                            "object": {
                                "type": "string",
                                "description": "The URN of the top-level share or ugcPost that contains the comment. Example: \"urn:li:activity:123\""
                            },
                            "message": {
                                "type": "object",
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "description": "The comment text."
                                    },
                                    "attributes": {
                                        "description": "Mention attributes in the comment text.",
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "length": {
                                                    "type": "number"
                                                },
                                                "start": {
                                                    "type": "number"
                                                },
                                                "value": {
                                                    "type": "object",
                                                    "properties": {
                                                        "organization": {
                                                            "type": "object",
                                                            "properties": {
                                                                "organization": {
                                                                    "type": "string"
                                                                }
                                                            },
                                                            "required": ["organization"],
                                                            "additionalProperties": false
                                                        },
                                                        "person": {
                                                            "type": "object",
                                                            "properties": {
                                                                "person": {
                                                                    "type": "string"
                                                                }
                                                            },
                                                            "required": ["person"],
                                                            "additionalProperties": false
                                                        }
                                                    },
                                                    "additionalProperties": false
                                                }
                                            },
                                            "required": ["length", "start"],
                                            "additionalProperties": false
                                        }
                                    }
                                },
                                "required": ["text"],
                                "additionalProperties": false
                            },
                            "parentComment": {
                                "description": "For nested comments, the URN of the parent comment. Example: \"urn:li:comment:(urn:li:activity:123,456)\"",
                                "type": "string"
                            }
                        },
                        "required": ["target", "actor", "object", "message"],
                        "additionalProperties": false
                    },
                    "ActionOutput_linkedin_createcomment": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "commentUrn": {
                                "type": "string"
                            },
                            "actor": {
                                "type": "string"
                            },
                            "agent": {
                                "type": "string"
                            },
                            "object": {
                                "type": "string"
                            },
                            "message": {
                                "type": "object",
                                "properties": {
                                    "text": {
                                        "type": "string"
                                    },
                                    "attributes": {
                                        "type": "array",
                                        "items": {}
                                    }
                                },
                                "additionalProperties": false
                            },
                            "created": {
                                "type": "object",
                                "properties": {
                                    "actor": {
                                        "type": "string"
                                    },
                                    "impersonator": {
                                        "type": "string"
                                    },
                                    "time": {
                                        "type": "number"
                                    }
                                },
                                "additionalProperties": false
                            },
                            "lastModified": {
                                "type": "object",
                                "properties": {
                                    "actor": {
                                        "type": "string"
                                    },
                                    "impersonator": {
                                        "type": "string"
                                    },
                                    "time": {
                                        "type": "number"
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "required": ["id"],
                        "additionalProperties": false
                    }
                }
            },
            "features": []
        },
