            "type": "tool",
            "name": "remove-api-key-tag-from-contact",
            "integrationId": "klicktipp",
            "description": "Remove the contact's association with the tag configured for the connection's listbuilding API key.",
            "trigger": {
                "kind": "http"
            },
            "requires": {
                "connection": true,
                "outbound": true,
                "invoke": false
            },
            "capabilities": {
                "usesRecords": false,
                "usesCheckpoints": false,
                "usesMetadata": false,
                "usesOutbound": true,
                "usesInvoke": false
            },
            "limits": {
                "concurrency": {
                    "perConnection": "max"
                }
            },
            "input_schema_ref": "#/definitions/FunctionInput_klicktipp_removeapikeytagfromcontact",
            "output_schema_ref": "#/definitions/FunctionOutput_klicktipp_removeapikeytagfromcontact",
            "model_schema_refs": [],
            "metadata_schema_ref": null,
            "checkpoint_schema_ref": null,
            "json_schema": {
                "definitions": {
                    "FunctionInput_klicktipp_removeapikeytagfromcontact": {
                        "type": "object",
                        "properties": {
                            "email": {
                                "type": "string",
                                "format": "email",
                                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                                "description": "Email address of the contact losing the configured key-linked tag association."
                            }
                        },
                        "required": [
                            "email"
                        ],
                        "additionalProperties": false,
                        "description": "Contact whose configured listbuilding API-key tag association will be removed."
                    },
                    "FunctionOutput_klicktipp_removeapikeytagfromcontact": {
                        "type": "object",
                        "properties": {
                            "success": {
                                "type": "boolean",
                                "description": "Provider aggregate tag-removal acknowledgement, not an unsubscribe acknowledgement."
                            }
                        },
                        "required": [
                            "success"
                        ],
                        "additionalProperties": false,
                        "description": "Aggregate acknowledgement of the configured tag association removal."
                    }
                }
            },
            "tags": {
                "read_only_hint": "false",
                "destructive_hint": "true",
                "idempotent_hint": "false",
                "instructions": "Use when removing the configured listbuilding tag rather than unsubscribing. You need the contact email, not a tag ID or secret key. Use `remove-tag-from-contact` to select a specific manual tag, or `unsubscribe-contact-via-api-key` to prevent communication."
            },
            "filePath": "./klicktipp/tools/remove-api-key-tag-from-contact.ts",
