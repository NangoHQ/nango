        {
            "type": "tool",
            "name": "unsubscribe-contact-via-api-key",
            "integrationId": "klicktipp",
            "description": "Unsubscribe a contact using the connection's listbuilding API key to prevent further communication.",
            "trigger": {
                "kind": "http"
            },
            "requires": {
                "connection": true,
                "outbound": true,
                "invoke": false
            },
            "capabilities": {
                "usesRecords": false,
                "usesCheckpoints": false,
                "usesMetadata": false,
                "usesOutbound": true,
                "usesInvoke": false
            },
            "limits": {
                "concurrency": {
                    "perConnection": "max"
                }
            },
            "input_schema_ref": "#/definitions/FunctionInput_klicktipp_unsubscribecontactviaapikey",
            "output_schema_ref": "#/definitions/FunctionOutput_klicktipp_unsubscribecontactviaapikey",
            "model_schema_refs": [],
            "metadata_schema_ref": null,
            "checkpoint_schema_ref": null,
            "json_schema": {
                "definitions": {
                    "FunctionInput_klicktipp_unsubscribecontactviaapikey": {
                        "type": "object",
                        "properties": {
                            "email": {
                                "type": "string",
                                "format": "email",
                                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                                "description": "Email address identifying the contact to unsubscribe."
                            }
                        },
                        "required": [
                            "email"
                        ],
                        "additionalProperties": false,
                        "description": "Contact to unsubscribe using the configured listbuilding API key."
                    },
                    "FunctionOutput_klicktipp_unsubscribecontactviaapikey": {
                        "type": "object",
                        "properties": {
                            "success": {
                                "type": "boolean",
                                "description": "Provider aggregate unsubscribe acknowledgement; does not imply contact deletion."
                            }
                        },
                        "required": [
                            "success"
                        ],
                        "additionalProperties": false,
                        "description": "Aggregate acknowledgement returned by KlickTipp for the unsubscribe operation."
                    }
                }
            },
            "tags": {
                "read_only_hint": "false",
                "destructive_hint": "true",
                "idempotent_hint": "false",
                "instructions": "Use this for the listbuilding-key context; use `unsubscribe-contact` for a management connection. The configured API key remains secret. This unsubscribes the contact, unlike `remove-api-key-tag-from-contact`, which removes only the key-linked tag. No automatic undo is promised."
            },
            "filePath": "./klicktipp/tools/unsubscribe-contact-via-api-key.ts",
