        {
            "type": "tool",
            "name": "create-server-access-token",
            "integrationId": "adobe",
            "description": "Issue an Adobe server-to-server access token for User Management API access using the connection's client credentials.",
            "trigger": {
                "kind": "http"
            },
            "requires": {
                "connection": true,
                "outbound": true,
                "invoke": false
            },
            "capabilities": {
                "usesRecords": false,
                "usesCheckpoints": false,
                "usesMetadata": false,
                "usesOutbound": true,
                "usesInvoke": false
            },
            "limits": {
                "concurrency": {
                    "perConnection": "max"
                }
            },
            "input_schema_ref": "#/definitions/FunctionInput_adobe_createserveraccesstoken",
            "output_schema_ref": "#/definitions/FunctionOutput_adobe_createserveraccesstoken",
            "model_schema_refs": [],
            "metadata_schema_ref": null,
            "checkpoint_schema_ref": null,
            "json_schema": {
                "definitions": {
                    "FunctionInput_adobe_createserveraccesstoken": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": false,
                        "description": "Issue a token using the connection credentials; no input parameters are accepted."
                    },
                    "FunctionOutput_adobe_createserveraccesstoken": {
                        "type": "object",
                        "properties": {
                            "tokenType": {
                                "description": "Provider token type, when supplied.",
                                "type": "string"
                            },
                            "accessToken": {
                                "type": "string",
                                "description": "Secret bearer credential to pass unchanged to the intended Adobe API client."
                            },
                            "expiresInSeconds": {
                                "description": "Provider-reported token validity duration in seconds; omitted if unavailable rather than guessed.",
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                            }
                        },
                        "required": [
                            "accessToken"
                        ],
                        "additionalProperties": false,
                        "description": "Secret Adobe server-to-server access token and available provider-reported token metadata."
                    }
                }
            },
            "tags": {
                "read_only_hint": "false",
                "destructive_hint": "false",
                "idempotent_hint": "false",
                "instructions": "Use only when a developer explicitly needs a token for an external Adobe API client. Ordinary tools authenticate automatically and do not require this call. Treat the result as a secret and do not put it in logs or user-visible text.",
                "required_scopes": {
                    "all": [
                        "AdobeID",
                        "openid",
                        "user_management_sdk"
                    ]
                }
            },
            "filePath": "./adobe/tools/create-server-access-token.ts",
            "version": "d79e4e009845bb04b16a42d1597a6eb105793fcf8cdc47ddbf23c3166a8fdb2f",
