            "input_schema_ref": "#/definitions/FunctionInput_adobe_getcurrentuser",
            "output_schema_ref": "#/definitions/FunctionOutput_adobe_getcurrentuser",
            "model_schema_refs": [],
            "metadata_schema_ref": null,
            "checkpoint_schema_ref": null,
            "json_schema": {
                "definitions": {
                    "FunctionInput_adobe_getcurrentuser": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": false,
                        "description": "No input is needed; reads the connected person."
                    },
                    "FunctionOutput_adobe_getcurrentuser": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "description": "Opaque subject identifier projected by openid.",
                                "type": "string"
                            },
                            "name": {
                                "description": "Full name if profile claims are available.",
                                "type": "string"
                            },
                            "email": {
                                "description": "Email address if email claims are available.",
                                "type": "string"
                            },
                            "lastName": {
                                "description": "Family name if available.",
                                "type": "string"
                            },
                            "firstName": {
                                "description": "Given name if available.",
                                "type": "string"
                            },
                            "accountType": {
                                "description": "individual maps from ind; organization maps from ent. Omitted if not supplied.",
                                "type": "string",
                                "enum": [
                                    "individual",
                                    "organization"
                                ]
                            },
                            "countryCode": {
                                "description": "Two-character address country code if address claims are available.",
                                "type": "string"
                            },
                            "emailVerified": {
                                "description": "Whether Adobe reports the email verified; absent is not false.",
                                "type": "boolean"
                            }
                        },
                        "additionalProperties": false,
                        "description": "Identity claims Adobe projects for the connected person."
                    }
                }
            },
            "tags": {
                "read_only_hint": "true",
                "destructive_hint": "false",
                "idempotent_hint": "true",
                "instructions": "Use for the connected person's identity, not organization directory administration. Use `get-user` for an arbitrary organization user. Additional consented profile, email and address scopes determine which optional claims Adobe returns.",
                "required_scopes": {
                    "all": [
                        "openid"
                    ]
                }
            },
            "filePath": "./adobe/tools/get-current-user.ts",
