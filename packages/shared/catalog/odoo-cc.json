            "json_schema": {
                "definitions": {
                    "ActionInput_odoo_cc_searchreadrecords": {
                        "type": "object",
                        "properties": {
                            "model": {
                                "type": "string",
                                "description": "Odoo model name. Example: \"res.partner\""
                            },
                            "domain": {
                                "description": "Odoo domain filter as a Python list string. Example: \"[['is_company','=',true]]\"",
                                "type": "string"
                            },
                            "fields": {
                                "description": "Field names to return. Example: [\"id\",\"name\",\"email\"]",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "limit": {
                                "description": "Maximum number of records to return. Default: 100",
                                "type": "number"
                            },
                            "offset": {
                                "description": "Number of records to skip",
                                "type": "number"
                            },
                            "order": {
                                "description": "Sort order. Example: \"write_date desc\"",
                                "type": "string"
                            },
                            "write_date": {
                                "description": "ISO datetime string; if provided adds a write_date filter to the domain",
                                "type": "string"
                            }
                        },
                        "required": ["model"],
                        "additionalProperties": false
                    },
                    "ActionOutput_odoo_cc_searchreadrecords": {
                        "type": "object",
                        "properties": {
                            "count": {
                                "type": "number"
                            },
