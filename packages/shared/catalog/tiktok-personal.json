                "definitions": {
                    "ActionInput_tiktok_personal_initvideoupload": {
                        "type": "object",
                        "properties": {
                            "post_info": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "description": "Video caption. Supports hashtags and @mentions. Max 2200 characters.",
                                        "type": "string"
                                    },
                                    "privacy_level": {
                                        "type": "string",
                                        "enum": ["PUBLIC_TO_EVERYONE", "MUTUAL_FOLLOW_FRIENDS", "FOLLOWER_OF_CREATOR", "SELF_ONLY"],
                                        "description": "Privacy level for the posted video."
                                    },
                                    "disable_duet": {
                                        "type": "boolean"
                                    },
                                    "disable_stitch": {
                                        "type": "boolean"
                                    },
                                    "disable_comment": {
                                        "type": "boolean"
                                    },
                                    "video_cover_timestamp_ms": {
                                        "description": "Timestamp in milliseconds for the video cover frame.",
                                        "type": "number"
                                    },
                                    "brand_content_toggle": {
                                        "type": "boolean"
                                    },
                                    "brand_organic_toggle": {
                                        "type": "boolean"
                                    },
                                    "is_aigc": {
                                        "description": "Whether the content is AI-generated.",
                                        "type": "boolean"
                                    }
                                },
                                "required": ["privacy_level"],
                                "additionalProperties": false
                            },
                            "source_info": {
                                "anyOf": [
                                    {
                                        "type": "object",
                                        "properties": {
                                            "source": {
                                                "type": "string",
                                                "const": "FILE_UPLOAD"
                                            },
                                            "video_size": {
                                                "type": "integer",
                                                "exclusiveMinimum": 0,
                                                "maximum": 9007199254740991,
                                                "description": "Size of the video in bytes."
                                            },
                                            "chunk_size": {
                                                "type": "integer",
                                                "exclusiveMinimum": 0,
                                                "maximum": 9007199254740991,
                                                "description": "Size of each upload chunk in bytes."
                                            },
                                            "total_chunk_count": {
                                                "type": "integer",
                                                "exclusiveMinimum": 0,
                                                "maximum": 9007199254740991,
                                                "description": "Total number of chunks."
                                            }
                                        },
                                        "required": ["source", "video_size", "chunk_size", "total_chunk_count"],
                                        "additionalProperties": false
                                    },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "source": {
                                                "type": "string",
                                                "const": "PULL_FROM_URL"
                                            },
                                            "video_url": {
                                                "type": "string",
                                                "description": "URL of the video. Domain must be verified with TikTok."
                                            }
                                        },
                                        "required": ["source", "video_url"],
                                        "additionalProperties": false
                                    }
                                ]
                            },
                            "post_mode": {
                                "description": "DIRECT_POST to publish immediately, MEDIA_UPLOAD to send to Creator Inbox.",
                                "type": "string",
                                "enum": ["DIRECT_POST", "MEDIA_UPLOAD"]
                            },
                            "media_type": {
                                "type": "string",
                                "const": "VIDEO"
                            }
                        },
                        "required": ["post_info", "source_info"],
                        "additionalProperties": false
                    },
                    "ActionOutput_tiktok_personal_initvideoupload": {
                        "type": "object",
                        "properties": {
                            "publish_id": {
                                "type": "string",
                                "description": "Identifier to track the posting action."
                            },
                            "upload_url": {
                                "description": "URL provided by TikTok to upload the video file. Only present for FILE_UPLOAD.",
                                "type": "string"
                            },
                            "post_id": {
                                "description": "Post ID if available.",
                                "type": "string"
                            }
                        },
                        "required": ["publish_id"],
                        "additionalProperties": false
                    }
                }
            },
            "features": []
        },
