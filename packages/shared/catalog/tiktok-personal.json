        {
            "type": "action",
            "description": "Initialize a TikTok photo post.",
            "endpoint": null,
            "input": "ActionInput_tiktok_personal_initphotoupload",
            "name": "init-photo-upload",
            "output": ["ActionOutput_tiktok_personal_initphotoupload"],
            "scopes": ["video.publish", "video.upload"],
            "usedModels": ["ActionInput_tiktok_personal_initphotoupload", "ActionOutput_tiktok_personal_initphotoupload"],
            "version": "1.0.2",
            "json_schema": {
                "definitions": {
                    "ActionInput_tiktok_personal_initphotoupload": {
                        "type": "object",
                        "properties": {
                            "media_type": {
                                "type": "string",
                                "const": "PHOTO",
                                "description": "Must be PHOTO."
                            },
                            "post_mode": {
                                "type": "string",
                                "enum": ["DIRECT_POST", "MEDIA_UPLOAD"],
                                "description": "DIRECT_POST or MEDIA_UPLOAD."
                            },
                            "post_info": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "description": "Post title. Max 90 UTF-16 runes.",
                                        "type": "string",
                                        "maxLength": 90
                                    },
                                    "description": {
                                        "description": "Post description. Max 4000 UTF-16 runes.",
                                        "type": "string",
                                        "maxLength": 4000
                                    },
                                    "privacy_level": {
                                        "description": "Privacy level. Required for DIRECT_POST.",
                                        "type": "string",
                                        "enum": ["PUBLIC_TO_EVERYONE", "MUTUAL_FOLLOW_FRIENDS", "FOLLOWER_OF_CREATOR", "SELF_ONLY"]
                                    },
                                    "disable_comment": {
                                        "description": "If true, disables comments. Only for DIRECT_POST.",
                                        "type": "boolean"
                                    },
                                    "auto_add_music": {
                                        "description": "If true, auto-adds recommended music. Only for DIRECT_POST.",
                                        "type": "boolean"
                                    },
                                    "brand_content_toggle": {
                                        "description": "If true, content is a paid partnership. Only for DIRECT_POST.",
                                        "type": "boolean"
                                    },
                                    "brand_organic_toggle": {
                                        "description": "If true, content promotes own business. Only for DIRECT_POST.",
                                        "type": "boolean"
                                    }
                                },
                                "additionalProperties": false,
                                "description": "Post metadata."
                            },
                            "source_info": {
                                "type": "object",
                                "properties": {
                                    "source": {
                                        "type": "string",
                                        "const": "PULL_FROM_URL",
                                        "description": "Must be PULL_FROM_URL for photos."
                                    },
                                    "photo_images": {
                                        "minItems": 1,
                                        "maxItems": 35,
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "format": "uri"
                                        },
                                        "description": "Publicly accessible photo URLs (1-35)."
                                    },
                                    "photo_cover_index": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991,
                                        "description": "Index of the cover photo, starting from 0."
                                    }
                                },
                                "required": ["source", "photo_images", "photo_cover_index"],
                                "additionalProperties": false,
                                "description": "Media source metadata."
                            }
                        },
                        "required": ["media_type", "post_mode", "post_info", "source_info"],
                        "additionalProperties": false
                    },
                    "ActionOutput_tiktok_personal_initphotoupload": {
                        "type": "object",
                        "properties": {
                            "publish_id": {
                                "type": "string",
                                "description": "Identifier to track the posting action."
                            }
                        },
                        "required": ["publish_id"],
                        "additionalProperties": false
                    }
                }
            },
            "features": []
        },
        {
            "type": "action",
