        {
            "type": "action",
            "description": "Generate a Meilisearch tenant token: a scoped, signed search JWT carrying per-index ACL rules. Expires after 1 hour unless expiresAt or expiresInSeconds is set.",
            "endpoint": null,
            "input": "ActionInput_meilisearch_generatetenanttoken",
            "name": "generate-tenant-token",
            "output": ["ActionOutput_meilisearch_generatetenanttoken"],
            "scopes": ["keys.get"],
            "usedModels": ["ActionInput_meilisearch_generatetenanttoken", "ActionOutput_meilisearch_generatetenanttoken"],
            "version": "1.0.0",
            "json_schema": {
                "definitions": {
                    "ActionInput_meilisearch_generatetenanttoken": {
                        "type": "object",
                        "properties": {
                            "searchRules": {
                                "type": "object",
                                "propertyNames": {
                                    "type": "string"
                                },
                                "additionalProperties": {
                                    "anyOf": [
                                        {
                                            "type": "object",
                                            "properties": {
                                                "filter": {
                                                    "anyOf": [
                                                        {
                                                            "type": "string"
                                                        },
                                                        {
                                                            "type": "array",
                                                            "items": {
                                                                "anyOf": [
                                                                    {
                                                                        "type": "string"
                                                                    },
                                                                    {
                                                                        "type": "array",
                                                                        "items": {
                                                                            "type": "string"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        }
                                                    ]
                                                }
                                            },
                                            "additionalProperties": false
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ]
                                },
                                "description": "Per-index search rules (the ACL carried by the token), keyed by index uid or \"*\"."
                            },
                            "expiresAt": {
                                "description": "Expiry as epoch seconds. Takes precedence over expiresInSeconds.",
                                "type": "number"
                            },
                            "expiresInSeconds": {
                                "description": "Expiry as a duration from now. Defaults to 3600 (1 hour) when neither field is set.",
                                "type": "number"
                            },
                            "apiKeyUid": {
                                "description": "Uid of the connection's API key. Must match the key used by this connection or Meilisearch will reject the token. When omitted, it is resolved by listing keys, which requires the keys.get action.",
                                "type": "string"
                            }
                        },
                        "required": ["searchRules"],
                        "additionalProperties": false
                    },
                    "ActionOutput_meilisearch_generatetenanttoken": {
                        "type": "object",
                        "properties": {
                            "token": {
                                "type": "string"
                            },
                            "expiresAt": {
                                "type": "number"
                            }
                        },
                        "required": ["token", "expiresAt"],
                        "additionalProperties": false
                    }
                }
            },
