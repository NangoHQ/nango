{
    "providerConfigKey": "ukg-pro",
    "actions": [],
    "syncs": [
        {
            "type": "sync",
            "description": "Fetch all employees from UKG Pro and maps them to the standard HRIS model",
            "auto_start": true,
            "endpoints": [
                {
                    "method": "GET",
                    "path": "/employees/unified",
                    "group": "Unified HRIS API"
                }
            ],
            "input": "SyncMetadata_ukg_pro_unifiedemployees",
            "name": "unified-employees",
            "output": ["StandardEmployee"],
            "runs": "every hour",
            "scopes": [],
            "sync_type": "full",
            "track_deletes": false,
            "usedModels": ["StandardEmployee", "SyncMetadata_ukg_pro_unifiedemployees"],
            "version": "0.1.0",
            "webhookSubscriptions": [],
            "json_schema": {
                "definitions": {
                    "StandardEmployee": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "firstName": {
                                "type": "string"
                            },
                            "lastName": {
                                "type": "string"
                            },
                            "email": {
                                "type": "string"
                            },
                            "displayName": {
                                "type": "string"
                            },
                            "employeeNumber": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            },
                            "department": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    }
                                },
                                "required": ["id", "name"],
                                "additionalProperties": false
                            },
                            "employmentType": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "const": "FULL_TIME"
                                    },
                                    {
                                        "type": "string",
                                        "const": "PART_TIME"
                                    },
                                    {
                                        "type": "string",
                                        "const": "CONTRACTOR"
                                    },
                                    {
                                        "type": "string",
                                        "const": "INTERN"
                                    },
                                    {
                                        "type": "string",
                                        "const": "TEMPORARY"
                                    },
                                    {
                                        "type": "string",
                                        "const": "OTHER"
                                    }
                                ]
                            },
                            "employmentStatus": {
                                "type": "string"
                            },
                            "startDate": {
                                "type": "string"
                            },
                            "terminationDate": {
                                "type": ["string", "null"]
                            },
                            "terminationType": {
                                "type": ["string", "null"]
                            },
                            "manager": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "firstName": {
                                        "type": "string"
                                    },
                                    "lastName": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string"
                                    }
                                },
                                "required": ["id", "firstName", "lastName", "email"],
                                "additionalProperties": false
                            },
                            "workLocation": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "type": {
                                        "anyOf": [
                                            {
                                                "type": "string",
                                                "const": "OFFICE"
                                            },
                                            {
                                                "type": "string",
                                                "const": "REMOTE"
                                            },
                                            {
                                                "type": "string",
                                                "const": "HYBRID"
                                            }
                                        ]
                                    },
                                    "primaryAddress": {
                                        "type": "object",
                                        "properties": {
                                            "street": {
                                                "type": "string"
                                            },
                                            "city": {
                                                "type": "string"
                                            },
                                            "state": {
                                                "type": "string"
                                            },
                                            "country": {
                                                "type": "string"
                                            },
                                            "postalCode": {
                                                "type": "string"
                                            },
                                            "type": {
                                                "anyOf": [
                                                    {
                                                        "type": "string",
                                                        "const": "WORK"
                                                    },
                                                    {
                                                        "type": "string",
                                                        "const": "HOME"
                                                    }
                                                ]
                                            }
                                        },
                                        "required": ["street", "city", "state", "country", "postalCode", "type"],
                                        "additionalProperties": false
                                    }
                                },
                                "required": ["name", "type"],
                                "additionalProperties": false
                            },
                            "addresses": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "street": {
                                            "type": "string"
                                        },
                                        "city": {
                                            "type": "string"
                                        },
                                        "state": {
                                            "type": "string"
                                        },
                                        "country": {
                                            "type": "string"
                                        },
                                        "postalCode": {
                                            "type": "string"
                                        },
                                        "type": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "HOME"
                                                },
                                                {
                                                    "type": "string",
                                                    "const": "WORK"
                                                }
                                            ]
                                        }
                                    },
                                    "required": ["street", "city", "state", "country", "postalCode", "type"],
                                    "additionalProperties": false
                                }
                            },
                            "phones": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "WORK"
                                                },
                                                {
                                                    "type": "string",
                                                    "const": "HOME"
                                                },
                                                {
                                                    "type": "string",
                                                    "const": "MOBILE"
                                                }
                                            ]
                                        },
                                        "number": {
                                            "type": "string"
                                        }
                                    },
                                    "required": ["type", "number"],
                                    "additionalProperties": false
                                }
                            },
                            "emails": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "WORK"
                                                },
                                                {
                                                    "type": "string",
                                                    "const": "PERSONAL"
                                                }
                                            ]
                                        },
                                        "address": {
                                            "type": "string"
                                        }
                                    },
                                    "required": ["type", "address"],
                                    "additionalProperties": false
                                }
                            },
                            "customFields": {
                                "type": "object",
                                "propertyNames": {
                                    "type": "string"
                                },
                                "additionalProperties": {}
                            },
                            "providerSpecific": {
                                "type": "object",
                                "propertyNames": {
                                    "type": "string"
                                },
                                "additionalProperties": {}
                            },
                            "createdAt": {
                                "type": "string"
                            },
                            "updatedAt": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "firstName",
                            "lastName",
                            "email",
                            "displayName",
                            "title",
                            "department",
                            "employmentType",
                            "startDate",
                            "terminationDate",
                            "terminationType",
                            "workLocation",
                            "addresses",
                            "phones",
                            "emails",
                            "providerSpecific",
                            "createdAt",
                            "updatedAt"
                        ],
                        "additionalProperties": false
                    },
                    "SyncMetadata_ukg_pro_unifiedemployees": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": false
                    }
                }
            },
            "features": ["checkpoints"]
        }
    ],
    "onEventScripts": {
        "post-connection-creation": [],
        "pre-connection-deletion": [],
        "validate-connection": []
    },
    "functions": [],
    "sdkVersion": "0.72.6"
}
