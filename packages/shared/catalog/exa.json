{
    "providerConfigKey": "exa",
    "actions": [
        {
            "type": "action",
            "description": "Generate an AI answer to a question, backed by live web citations.",
            "endpoint": {
                "path": "/actions/answer",
                "method": "POST"
            },
            "input": "ActionInput_exa_answer",
            "name": "answer",
            "output": ["ActionOutput_exa_answer"],
            "scopes": [],
            "usedModels": ["ActionInput_exa_answer", "ActionOutput_exa_answer"],
            "version": "1.0.0",
            "json_schema": {
                "definitions": {
                    "ActionInput_exa_answer": {
                        "type": "object",
                        "properties": {
                            "query": {
                                "type": "string",
                                "description": "The question to answer. Example: \"What is the capital of France?\""
                            },
                            "text": {
                                "description": "If true, each citation object includes the full page text.",
                                "type": "boolean"
                            }
                        },
                        "required": ["query"],
                        "additionalProperties": false
                    },
                    "ActionOutput_exa_answer": {
                        "type": "object",
                        "properties": {
                            "answer": {
                                "type": "string",
                                "description": "The AI-generated answer, may contain markdown."
                            },
                            "citations": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string"
                                        },
                                        "title": {
                                            "type": "string"
                                        },
                                        "url": {
                                            "type": "string"
                                        },
                                        "text": {
                                            "type": "string"
                                        }
                                    },
                                    "required": ["id"],
                                    "additionalProperties": false
                                },
                                "description": "Citations backing the answer."
                            }
                        },
                        "required": ["answer", "citations"],
                        "additionalProperties": false
                    }
                }
            },
            "features": []
        },
        {
            "type": "action",
            "description": "Find pages semantically similar to a given URL.",
            "endpoint": {
                "path": "/actions/find-similar",
                "method": "POST"
            },
            "input": "ActionInput_exa_findsimilar",
            "name": "find-similar",
            "output": ["ActionOutput_exa_findsimilar"],
            "scopes": [],
            "usedModels": ["ActionInput_exa_findsimilar", "ActionOutput_exa_findsimilar"],
            "version": "1.0.0",
            "json_schema": {
                "definitions": {
                    "ActionInput_exa_findsimilar": {
                        "type": "object",
                        "properties": {
                            "url": {
                                "type": "string",
                                "description": "The seed URL for which to find similar pages. Example: \"https://arxiv.org/abs/2307.06435\""
                            },
                            "numResults": {
                                "description": "Number of results to return. Default: 10. Maximum public limit is 100.",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100
                            },
                            "excludeSourceDomain": {
                                "description": "If true, results from the same domain as the input URL are excluded.",
                                "type": "boolean"
                            },
                            "category": {
                                "description": "Category filter to focus the search on a specific type of content.",
                                "type": "string",
                                "enum": [
                                    "company",
                                    "research paper",
                                    "news",
                                    "pdf",
                                    "github",
                                    "personal site",
                                    "linkedin profile",
                                    "people",
                                    "financial report"
                                ]
                            },
                            "includeDomains": {
                                "description": "List of domains to include in results.",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "excludeDomains": {
                                "description": "List of domains to exclude from results.",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "startPublishedDate": {
                                "description": "Only include links with a published date after this date. ISO 8601 format.",
                                "type": "string"
                            },
                            "endPublishedDate": {
                                "description": "Only include links with a published date before this date. ISO 8601 format.",
                                "type": "string"
                            },
                            "contents": {
                                "description": "Inline content options (text, highlights, summary, extras) to fetch in the same call.",
                                "type": "object",
                                "properties": {
                                    "text": {
                                        "anyOf": [
                                            {
                                                "type": "boolean"
                                            },
                                            {
                                                "type": "object",
                                                "properties": {
                                                    "maxCharacters": {
                                                        "type": "number"
                                                    },
                                                    "includeHtmlTags": {
                                                        "type": "boolean"
                                                    },
                                                    "verbosity": {
                                                        "type": "string",
                                                        "enum": ["compact", "standard", "full"]
                                                    },
                                                    "includeSections": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "excludeSections": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        }
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        ]
                                    },
                                    "highlights": {
                                        "anyOf": [
                                            {
                                                "type": "boolean"
                                            },
                                            {
                                                "type": "object",
                                                "properties": {
                                                    "query": {
                                                        "type": "string"
                                                    },
                                                    "maxCharacters": {
                                                        "type": "number"
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        ]
                                    },
                                    "summary": {
                                        "type": "object",
                                        "properties": {
                                            "query": {
                                                "type": "string"
                                            },
                                            "schema": {
                                                "type": "object",
                                                "properties": {},
                                                "additionalProperties": {}
                                            }
                                        },
                                        "additionalProperties": false
                                    },
                                    "extras": {
                                        "type": "object",
                                        "properties": {
                                            "links": {
                                                "type": "number"
                                            },
                                            "imageLinks": {
                                                "type": "number"
                                            },
                                            "richImageLinks": {
                                                "type": "number"
                                            },
                                            "richLinks": {
                                                "type": "number"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "required": ["url"],
                        "additionalProperties": false
                    },
                    "ActionOutput_exa_findsimilar": {
                        "type": "object",
                        "properties": {
                            "requestId": {
                                "type": "string"
                            },
                            "results": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "description": "The result ID, which is the full URL string."
                                        },
                                        "title": {
                                            "type": "string"
                                        },
                                        "url": {
                                            "type": "string"
                                        },
                                        "score": {
                                            "description": "Relevance score for the result.",
                                            "type": "number"
                                        },
                                        "publishedDate": {
                                            "type": ["string", "null"]
                                        },
                                        "author": {
                                            "type": ["string", "null"]
                                        },
                                        "image": {
                                            "type": "string"
                                        },
                                        "favicon": {
                                            "type": "string"
                                        },
                                        "text": {
                                            "type": "string"
                                        },
                                        "highlights": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "highlightScores": {
                                            "type": "array",
                                            "items": {
                                                "type": "number"
                                            }
                                        },
                                        "summary": {
                                            "type": "string"
                                        },
                                        "subpages": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "title": {
                                                        "type": "string"
                                                    },
                                                    "url": {
                                                        "type": "string"
                                                    },
                                                    "publishedDate": {
                                                        "type": "string"
                                                    },
                                                    "author": {
                                                        "type": ["string", "null"]
                                                    },
                                                    "image": {
                                                        "type": "string"
                                                    },
                                                    "favicon": {
                                                        "type": "string"
                                                    }
                                                },
                                                "required": ["title", "url"],
                                                "additionalProperties": false
                                            }
                                        },
                                        "extras": {
                                            "type": "object",
                                            "properties": {
                                                "links": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "additionalProperties": false
                                        },
                                        "entities": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": ["id", "title", "url"],
                                    "additionalProperties": false
                                }
                            },
                            "costDollars": {
                                "type": "object",
                                "properties": {
                                    "total": {
                                        "type": "number"
                                    },
                                    "search": {
                                        "type": "object",
                                        "properties": {
                                            "neural": {
                                                "type": "number"
                                            }
                                        },
                                        "additionalProperties": false
                                    },
                                    "breakDown": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {},
                                            "additionalProperties": {}
                                        }
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "required": ["results"],
                        "additionalProperties": false
                    }
                }
            },
            "features": []
        },
        {
