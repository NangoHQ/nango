                                "type": "string"
                            },
                            "startCrawlDate": {
                                "description": "ISO 8601 start crawl date filter.",
                                "type": "string"
                            },
                            "endCrawlDate": {
                                "description": "ISO 8601 end crawl date filter.",
                                "type": "string"
                            },
                            "text": {
                                "description": "Inline text extraction options (avoids separate /contents call).",
                                "type": "object",
                                "properties": {
                                    "maxCharacters": {
                                        "description": "Maximum characters to return for page text.",
                                        "type": "integer",
                                        "minimum": -9007199254740991,
                                        "maximum": 9007199254740991
                                    },
                                    "includeHtmlTags": {
                                        "description": "Include HTML tags in returned text.",
                                        "type": "boolean"
                                    }
                                },
                                "additionalProperties": false
                            },
                            "highlights": {
                                "description": "Inline highlight extraction options (avoids separate /contents call).",
                                "type": "object",
                                "properties": {
                                    "query": {
                                        "description": "Custom query guiding highlight selection.",
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false
                            },
                            "summary": {
                                "description": "Inline summary generation options (avoids separate /contents call).",
                                "type": "object",
                                "properties": {
                                    "query": {
                                        "description": "Custom query for LLM-generated summary.",
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "required": ["query"],
                        "additionalProperties": false
                    },
                    "ActionOutput_exa_search": {
                        "type": "object",
                        "properties": {
                            "requestId": {
                                "description": "Unique identifier for the request.",
                                "type": "string"
                            },
                            "results": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "description": "Result ID (the full URL)."
                                        },
                                        "title": {
                                            "description": "Title of the search result.",
                                            "type": "string"
                                        },
                                        "url": {
                                            "description": "URL of the search result.",
                                            "type": "string"
                                        },
                                        "publishedDate": {
                                            "description": "Estimated published date in ISO 8601 format.",
                                            "type": "string"
                                        },
