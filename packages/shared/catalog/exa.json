        {
            "type": "action",
            "description": "Run an Exa neural or keyword search and return ranked results, optionally with inline page content.",
            "endpoint": null,
            "input": "ActionInput_exa_search",
            "name": "search",
            "output": ["ActionOutput_exa_search"],
            "scopes": [],
            "usedModels": ["ActionInput_exa_search", "ActionOutput_exa_search"],
            "version": "1.0.0",
            "json_schema": {
                "definitions": {
                    "ActionInput_exa_search": {
                        "type": "object",
                        "properties": {
                            "query": {
                                "type": "string",
                                "minLength": 1,
                                "description": "The search query string."
                            },
                            "type": {
                                "description": "Search type: 'auto' (default), 'neural' for semantic, 'keyword' for exact-match, 'fast', 'instant', 'deep-lite', 'deep', or 'deep-reasoning'.",
                                "type": "string",
                                "enum": ["auto", "neural", "keyword", "fast", "instant", "deep-lite", "deep", "deep-reasoning"]
                            },
                            "numResults": {
                                "description": "Number of results to return (default 10).",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100
                            },
                            "category": {
                                "description": "Content category filter.",
                                "type": "string",
                                "enum": [
                                    "company",
                                    "research paper",
                                    "news",
                                    "pdf",
                                    "github",
                                    "personal site",
                                    "linkedin profile",
                                    "people",
                                    "financial report"
                                ]
                            },
                            "includeDomains": {
                                "description": "Only return results from these domains.",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "excludeDomains": {
                                "description": "Exclude results from these domains.",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "startPublishedDate": {
