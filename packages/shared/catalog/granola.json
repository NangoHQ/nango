        {
            "type": "action",
            "description": "List meeting notes visible to the API key, with date and folder filtering.",
            "endpoint": null,
            "input": "ActionInput_granola_listnotes",
            "name": "list-notes",
            "output": ["ActionOutput_granola_listnotes"],
            "scopes": [],
            "usedModels": ["ActionInput_granola_listnotes", "ActionOutput_granola_listnotes"],
            "version": "1.0.0",
            "json_schema": {
                "definitions": {
                    "ActionInput_granola_listnotes": {
                        "type": "object",
                        "properties": {
                            "created_before": {
                                "description": "Return notes created before this date. Accepts ISO 8601 date or date-time strings.",
                                "type": "string"
                            },
                            "created_after": {
                                "description": "Return notes created after this date. Accepts ISO 8601 date or date-time strings.",
                                "type": "string"
                            },
                            "updated_after": {
                                "description": "Return notes updated after this date. Accepts ISO 8601 date or date-time strings. This filter is precise and will return an empty list if no notes match.",
                                "type": "string"
                            },
                            "folder_id": {
                                "description": "Return notes in this folder and any of its child folders. Use the list folders endpoint to discover folder IDs.",
                                "type": "string",
                                "pattern": "^fol_[a-zA-Z0-9]{14}$"
                            },
                            "cursor": {
                                "description": "Pagination cursor from the previous response. Omit for the first page.",
                                "type": "string"
                            },
                            "page_size": {
                                "description": "Maximum number of notes to return per page. Defaults to 10, capped at 30.",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 30
                            }
                        },
                        "additionalProperties": false,
                        "description": "Input for listing Granola meeting notes."
                    },
                    "ActionOutput_granola_listnotes": {
                        "type": "object",
                        "properties": {
                            "notes": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "description": "The ID of the note."
                                        },
                                        "object": {
                                            "type": "string",
                                            "const": "note",
                                            "description": "The object type of the note."
                                        },
                                        "title": {
                                            "description": "The title of the note, if present.",
                                            "type": "string"
                                        },
                                        "owner": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "description": "The name of the note owner, if known.",
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "description": "The email of the note owner."
                                                }
                                            },
                                            "required": ["email"],
                                            "additionalProperties": false,
                                            "description": "The owner of the note."
                                        },
                                        "created_at": {
                                            "type": "string",
                                            "description": "The creation time of the note in ISO 8601 format."
                                        },
                                        "updated_at": {
                                            "type": "string",
                                            "description": "The last update time of the note in ISO 8601 format."
                                        }
                                    },
                                    "required": ["id", "object", "owner", "created_at", "updated_at"],
                                    "additionalProperties": false
                                },
                                "description": "The list of notes visible to the API key."
                            },
                            "hasMore": {
                                "type": "boolean",
                                "description": "Whether another page of notes is available."
                            },
                            "next_cursor": {
                                "description": "The opaque cursor for the next page, or omitted when this is the final page.",
                                "type": "string"
                            }
                        },
                        "required": ["notes", "hasMore"],
                        "additionalProperties": false,
                        "description": "Output from listing Granola meeting notes."
                    }
                }
            },
            "features": []
        }
    ],
