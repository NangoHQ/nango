                                        "name": {
                                            "type": "string",
                                            "description": "Name of the folder."
                                        },
                                        "parent_folder_id": {
                                            "description": "ID of the parent folder, or null for top-level folders.",
                                            "type": ["string", "null"]
                                        },
                                        "space_id": {
                                            "description": "ID of the space this folder belongs to.",
