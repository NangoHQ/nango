        {
            "type": "action",
            "description": "List uploaded bulk verification files, with filtering.",
            "endpoint": null,
            "input": "ActionInput_millionverifier_listbulkfiles",
            "name": "list-bulk-files",
            "output": ["ActionOutput_millionverifier_listbulkfiles"],
            "scopes": [],
            "usedModels": ["ActionInput_millionverifier_listbulkfiles", "ActionOutput_millionverifier_listbulkfiles"],
            "version": "1.0.0",
            "json_schema": {
                "definitions": {
                    "ActionInput_millionverifier_listbulkfiles": {
                        "type": "object",
                        "properties": {
                            "offset": {
                                "description": "Offset for pagination. Example: 0",
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                            },
                            "limit": {
                                "description": "The amount of files to show on one page. Defaults to 50, max 50. Example: 25",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 50
                            },
                            "id": {
                                "description": "Filter for file IDs. Comma separated values allowed. Example: \"1,2,3\"",
                                "type": "string"
                            },
                            "name": {
                                "description": "Filter for file name. Example: \"myfile.txt\"",
                                "type": "string"
                            },
                            "status": {
                                "description": "Filter for file state. Example: \"in_progress,finished\"",
                                "type": "string"
                            },
                            "updated_at_from": {
                                "description": "Filter for files updated after the given date time. Format: yyyy-MM-dd HH:mm:ss. Example: \"2023-01-01 15:00:05\"",
                                "type": "string",
                                "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
                            },
                            "updated_at_to": {
                                "description": "Filter for files updated before the given date time. Format: yyyy-MM-dd HH:mm:ss. Example: \"2023-01-01 15:00:05\"",
                                "type": "string",
                                "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
                            },
                            "createdate_from": {
                                "description": "Filter for files created after the given date time. Format: yyyy-MM-dd HH:mm:ss. Example: \"2023-01-01 15:00:05\"",
                                "type": "string",
                                "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
                            },
                            "createdate_to": {
                                "description": "Filter for files created before the given date time. Format: yyyy-MM-dd HH:mm:ss. Example: \"2023-01-01 15:00:05\"",
                                "type": "string",
                                "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
                            },
                            "percent_from": {
                                "description": "Filter for files with progress over the given percentage. Example: 50",
                                "type": "number"
                            },
                            "percent_to": {
                                "description": "Filter for files with progress below the given percentage. Example: 75",
                                "type": "number"
                            },
                            "has_error": {
                                "description": "Filter for files that had or did not have errors. Example: \"true\" or \"false\"",
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    },
                    "ActionOutput_millionverifier_listbulkfiles": {
                        "type": "object",
                        "properties": {
                            "files": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "file_id": {
                                            "type": "string"
                                        },
                                        "file_name": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string"
                                        },
                                        "unique_emails": {
                                            "type": "number"
                                        },
                                        "updated_at": {
                                            "type": "string"
                                        },
                                        "createdate": {
                                            "type": "string"
                                        },
                                        "percent": {
                                            "type": "number"
                                        },
                                        "total_rows": {
                                            "type": "number"
                                        },
                                        "verified": {
                                            "type": "number"
                                        },
                                        "unverified": {
                                            "type": "number"
                                        },
                                        "ok": {
                                            "type": "number"
                                        },
                                        "catch_all": {
                                            "type": "number"
                                        },
                                        "disposable": {
                                            "type": "number"
                                        },
                                        "invalid": {
                                            "type": "number"
                                        },
                                        "unknown": {
                                            "type": "number"
                                        },
                                        "reverify": {
                                            "type": "number"
                                        },
                                        "credit": {
                                            "type": "number"
                                        },
                                        "estimated_time_sec": {
                                            "type": "number"
                                        },
                                        "error": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "file_id",
                                        "file_name",
                                        "status",
                                        "unique_emails",
                                        "updated_at",
                                        "createdate",
                                        "percent",
                                        "total_rows",
                                        "verified",
                                        "unverified",
                                        "ok",
                                        "catch_all",
                                        "disposable",
                                        "invalid",
                                        "unknown",
                                        "reverify",
                                        "credit",
                                        "estimated_time_sec",
                                        "error"
                                    ],
                                    "additionalProperties": false
                                }
                            },
                            "total": {
                                "type": "number"
                            }
                        },
                        "required": ["files", "total"],
                        "additionalProperties": false
                    }
                }
            },
            "features": []
