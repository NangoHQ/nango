                            "filter": {
                                "type": "string",
                                "enum": ["ok", "ok_and_catch_all", "unknown", "invalid", "all", "custom"],
                                "description": "Result filter preset. Example: \"all\""
                            },
                            "statuses": {
                                "description": "When filter is \"custom\", comma-separated statuses. Example: \"ok,disposable,invalid\"",
                                "type": "string"
                            },
                            "free": {
                                "description": "When filter is \"custom\", \"1\" or \"0\" to filter free domains",
                                "type": "string"
                            },
                            "role": {
                                "description": "When filter is \"custom\", \"1\" or \"0\" to filter role emails",
                                "type": "string"
                            }
                        },
