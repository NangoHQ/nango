                                    },
                                    {
                                        "type": "string",
                                        "const": "member"
                                    },
                                    {
                                        "type": "string",
                                        "const": "project_creator"
                                    },
                                    {
                                        "type": "string",
                                        "const": "billable_rates_manager"
                                    },
                                    {
                                        "type": "string",
                                        "const": "managed_projects_invoice_drafter"
                                    },
                                    {
                                        "type": "string",
                                        "const": "managed_projects_invoice_manager"
                                    },
                                    {
                                        "type": "string",
                                        "const": "client_and_task_manager"
                                    },
                                    {
                                        "type": "string",
                                        "const": "time_and_expenses_manager"
                                    },
                                    {
                                        "type": "string",
                                        "const": "estimates_manager"
                                    }
