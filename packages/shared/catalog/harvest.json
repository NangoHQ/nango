                    "ActionOutput_harvest_createuser": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "email": {
                                "type": "string"
                            },
                            "firstName": {
                                "type": "string"
                            },
                            "lastName": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "email",
                            "firstName",
                            "lastName"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "features": []
        },
